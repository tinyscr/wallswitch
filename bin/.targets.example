# wallswitch targets - edit this file.
# [Desktop] applies the image live to the current desktop.
# [Terminal] rewrites the backgroundImage in Windows Terminal's settings.json.
# [Registry] persists it to the registry so it survives reboots.
# Apply order: Desktop -> Terminal -> Registry.
# Each section supports Enable plus target-specific keys (SettingsPath).

[Desktop]
Enable=true

[Terminal]
Enable=false
SettingsPath=C:\Users\<you>\AppData\Local\Packages\Microsoft.WindowsTerminal_8wekyb3d8bbwe\LocalState\settings.json

[Registry]
Enable=true
